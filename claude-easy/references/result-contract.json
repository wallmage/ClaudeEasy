{
  "schema": "claude-easy.result",
  "version": 1,
  "required_fields": [
    "schema",
    "version",
    "command",
    "platform",
    "client",
    "operation",
    "ok",
    "status",
    "code",
    "exit_code",
    "summary_zh",
    "profile",
    "changes",
    "checks",
    "items",
    "messages",
    "warnings"
  ],
  "statuses": [
    "ok",
    "no_change",
    "skipped",
    "failed",
    "rolled_back",
    "partial",
    "invalid_request",
    "unsupported"
  ],
  "item_statuses": [
    "updated",
    "unchanged",
    "skipped",
    "failed",
    "rolled_back",
    "pending"
  ],
  "commands": [
    "install",
    "uninstall",
    "patch",
    "verify_routes"
  ],
  "field_types": {
    "schema": "string",
    "version": "integer",
    "command": "string",
    "platform": "string",
    "client": "string",
    "operation": "string",
    "ok": "boolean",
    "status": "string",
    "code": "string",
    "exit_code": "integer",
    "summary_zh": "string",
    "profile": ["integer", "null"],
    "changes": "array",
    "checks": "array",
    "items": "array",
    "messages": "array",
    "warnings": "array"
  },
  "optional_field_types": {
    "workflow_complete": "boolean",
    "completed_scope": "string",
    "required_followups": "array"
  },
  "required_workflow_metadata_by_code": {
    "safe_update_completed": {
      "workflow_complete": false,
      "completed_scope": "subscription_update",
      "required_followups": "non_empty_array"
    },
    "safe_update_verified": {
      "workflow_complete": false,
      "completed_scope": "subscription_update",
      "required_followups": "non_empty_array"
    },
    "runtime_activation_required": {
      "workflow_complete": false,
      "completed_scope": "configuration_written",
      "required_followups": "non_empty_array"
    },
    "runtime_activation_recovery_required": {
      "workflow_complete": false,
      "completed_scope": "configuration_restored",
      "required_followups": "non_empty_array"
    },
    "runtime_activation_configuration_recovery_required": {
      "workflow_complete": false,
      "completed_scope": "runtime_restored",
      "required_followups": "non_empty_array"
    },
    "runtime_activation_recovery_failed": {
      "workflow_complete": false,
      "completed_scope": "recovery_attempted",
      "required_followups": "non_empty_array"
    }
  },
  "required_workflow_metadata_by_operation_and_code": {
    "snapshot_profiles:snapshot_created": {
      "workflow_complete": false,
      "completed_scope": "subscription_snapshot",
      "required_followups": "non_empty_array"
    }
  },
  "platforms": {
    "macos": {
      "client": "clashx-meta",
      "json_argument": "--json"
    },
    "windows": {
      "client": "clash-verge-rev",
      "json_argument": "-Json"
    }
  }
}
