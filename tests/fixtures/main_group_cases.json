  "transform_cases": [
    {
      "name": "automatic-main-group-receives-full-patch",
      "expected_config_sha256": "f603b9d91bf68abe503a4df10ab1d6d2c565af5342503e0b88b942fbb7164068",
      "input": {
        "proxies": [{ "name": "node-a", "type": "ss", "server": "node-a.example" }],
        "proxy-groups": [
          { "name": "Auto", "type": "url-test", "proxies": ["node-a"], "url": "https://example.invalid", "interval": 300 }
        ],
        "rules": ["MATCH,Auto"]
      },
      "expected_changed": true,
      "expected_main_group": "Auto",
      "expected_ai_group": "🤖 AI · ClaudeEasy",
      "expected_status": "updated",
      "expected_present_strings": [
        "\"proxy\":\"Auto\"",
        "NETWORK,UDP,🤖 AI · ClaudeEasy"
      ]
    },
    {
      "name": "reuse-existing-ai-group",
      "expected_config_sha256": "66ebbb5fcb387d6088db9ae264628548501927bbbe43fe0b7581a898b6e5a27f",
      "input": {
        "proxies": [{ "name": "node-a", "type": "ss", "server": "node-a.example" }],
        "proxy-groups": [
          { "name": "Main", "type": "select", "proxies": ["node-a"] },
          { "name": "AI", "type": "select", "proxies": ["node-a"], "icon": "keep-me" }
        ],
        "rules": ["MATCH,Main"]
      },
      "expected_changed": true,
      "expected_main_group": "Main",
      "expected_ai_group": "AI",
      "expected_status": "updated"
    },
    {
      "name": "create-independent-ai-from-provider",
      "expected_config_sha256": "a5b476bfa319c852be77c8e83b482e7c97fde2ae8b2991252ee2c2dbae056e95",
      "input": {
        "proxy-providers": {
          "provider-a": { "type": "http", "url": "https://fixture.invalid/sub", "interval": 3600 }
        },
        "proxy-groups": [
          { "name": "Main", "type": "select", "use": ["provider-a"] }
        ],
        "rules": ["MATCH,Main"]
      },
      "expected_changed": true,
      "expected_main_group": "Main",
      "expected_ai_group": "🤖 AI · ClaudeEasy",
      "expected_status": "updated"
    },
    {
